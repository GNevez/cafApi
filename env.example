# Configurações de Desenvolvimento
# Copie este arquivo para .env e ajuste os valores conforme necessário

FRONTEND_DEVELOPMENT_URL=http://localhost:3000
FRONTEND_PRODUCTION_URL=https://chaseaflare.com.br

# JWT Secret (para desenvolvimento local)
JWT_KEY=REMOVED_JWT_SECRET

# Database
CONNECTION_STRING=server=localhost;database=chase-a-flare;user=root;password=;TreatTinyAsBoolean=false;SslMode=None;
